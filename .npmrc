## Resolve packages from the public npm registry so lockfile URLs stay on registry.npmjs.org.
registry=https://registry.npmjs.org/

## Avoid installing packages published in last 3 days.
min-release-age=3

## These majors published inside the cooldown window and are adopted on purpose.
min-release-age-exclude[]=@toruslabs/constants
min-release-age-exclude[]=@toruslabs/metadata-helpers
min-release-age-exclude[]=@toruslabs/secure-pub-sub
min-release-age-exclude[]=@toruslabs/session-manager

## Don't install packages from git urls.
allow-git=none

## Disable installing dependencies from remote URLs.
allow-remote=none

## Pin allowed scripts to exact versions of dependencies to prevent unexpected script execution.
allow-scripts-pin=true
