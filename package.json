{
  "name": "@web3auth/auth",
  "version": "11.8.3",
  "description": "Auth sdk for web3auth",
  "repository": "git@github.com:web3auth/Auth.git",
  "sideEffects": false,
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.cjs/index.d.ts",
      "import": "./dist/lib.esm/index.js",
      "require": "./dist/lib.cjs/index.js"
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    },
    "./core": {
      "types": "./dist/lib.cjs/core/index.d.ts",
      "import": "./dist/lib.esm/core/index.js",
      "require": "./dist/lib.cjs/core/index.js"
    },
    "./ed25519": {
      "types": "./dist/lib.cjs/ed25519/index.d.ts",
      "import": "./dist/lib.esm/ed25519/index.js",
      "require": "./dist/lib.cjs/ed25519/index.js"
    },
    "./jrpc": {
      "types": "./dist/lib.cjs/jrpc/index.d.ts",
      "import": "./dist/lib.esm/jrpc/index.js",
      "require": "./dist/lib.cjs/jrpc/index.js"
    },
    "./subkey": {
      "types": "./dist/lib.cjs/subkey/index.d.ts",
      "import": "./dist/lib.esm/subkey/index.js",
      "require": "./dist/lib.cjs/subkey/index.js"
    },
    "./utils": {
      "types": "./dist/lib.cjs/utils/index.d.ts",
      "import": "./dist/lib.esm/utils/index.js",
      "require": "./dist/lib.cjs/utils/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "harden": "harden check --package-manager npm --level moderate",
    "prepack": "npm run build",
    "test": "vp test run --config test/configs/node.config.mts --coverage",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@toruslabs/tweetnacl-js": "^1.0.4",
    "@types/deep-freeze-strict": "^1.1.2",
    "@types/node": "^25",
    "@types/once": "^1.4.5",
    "@types/readable-stream": "^4.0.23",
    "@vitest/coverage-istanbul": "5.1.0",
    "color": "^5.0.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0"
  },
  "peerDependencies": {
    "color": "^5.x"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "dependencies": {
    "@toruslabs/constants": "^17.0.0",
    "@toruslabs/customauth": "^22.3.3",
    "@toruslabs/ffjavascript": "^7.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "@toruslabs/secure-pub-sub": "^5.0.0",
    "@toruslabs/session-manager": "^6.0.0",
    "deep-freeze-strict": "^1.1.1",
    "events": "^3.3.0",
    "json-stable-stringify": "^1.3.0",
    "klona": "^2.0.6",
    "loglevel": "^1.9.2",
    "once": "^1.4.0",
    "readable-stream": "^4.8.0",
    "typed-emitter": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
